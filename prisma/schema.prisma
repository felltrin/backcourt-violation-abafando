// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id    String  @id @default(auto()) @map("_id") @db.ObjectId
    email String  @unique
    name  String?
    posts Post[]
}

model Post {
    id        String  @id @default(auto()) @map("_id") @db.ObjectId
    title     String
    content   String?
    published Boolean @default(false)
    author    User    @relation(fields: [authorId], references: [id])
    authorId  String  @db.ObjectId
}

enum Icon {
    CAR       @map("car")
    CAR_FRONT @map("car-front")
    CROWN     @map("crown")
    USERS     @map("users")
    ZAP       @map("zap")
}

model RideType {
    id              String @id @default(auto()) @map("_id") @db.ObjectId
    name            String
    description     String
    capacity        Int
    eta             String
    priceMultiplier Int
    basePrice       Int
    icon            Icon   @default(CAR)
}

model Location {
    id      String @id @default(auto()) @map("_id") @db.ObjectId
    name    String
    address String
    lat     Int
    lng     Int
}

enum SavedPlaceIcon {
    HOME      @map("home")
    BRIEFCASE @map("briefcase")
    STAR      @map("star")
}

model SavedPlace {
    id      String         @id @default(auto()) @map("_id") @db.ObjectId
    name    String
    address String
    icon    SavedPlaceIcon
}

enum RideHistoryStatus {
    COMPLETED @map("completed")
    CANCELLED @map("cancelled")
}

model RideHistory {
    id           String            @id @default(auto()) @map("_id") @db.ObjectId
    date         String
    pickup       String
    dropoff      String
    price        String
    driverName   String
    driverRating Int
    vehicleType  String
    status       RideHistoryStatus
    duration     String
    distance     String
}
