// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
    binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id    String  @id @default(auto()) @map("_id") @db.ObjectId
    email String  @unique
    name  String?
    posts Post[]
}

model Post {
    id        String  @id @default(auto()) @map("_id") @db.ObjectId
    title     String
    content   String?
    published Boolean @default(false)
    author    User    @relation(fields: [authorId], references: [id])
    authorId  String  @db.ObjectId
}

model RideType {
    id              String @id @default(auto()) @map("_id") @db.ObjectId
    name            String
    description     String
    capacity        Int
    eta             String
    priceMultiplier Float
    basePrice       Float
    icon            String
}

model SearchSuggestion {
    id      String @id @default(auto()) @map("_id") @db.ObjectId
    name    String
    address String
    lat     Float
    lng     Float
}

model RecentLocation {
    id      String @id @default(auto()) @map("_id") @db.ObjectId
    name    String
    address String
    lat     Float
    lng     Float
}

model SavedPlace {
    id      String @id @default(auto()) @map("_id") @db.ObjectId
    name    String
    address String
    icon    String
}

model RideHistory {
    id           String @id @default(auto()) @map("_id") @db.ObjectId
    date         String
    pickup       String
    dropoff      String
    price        String
    driverName   String
    driverRating Float
    vehicleType  String
    status       String
    duration     String
    distance     String
}

model Driver {
    id             String @id @default(auto()) @map("_id") @db.ObjectId
    name           String
    rating         Float
    trips          Int
    vehicle        String
    licensePlate   String
    eta            Int
    avatarInitials String
}

model Promotion {
    id          String @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    description String
    code        String
    discount    String
}
